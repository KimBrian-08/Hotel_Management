    "class Guest(Person):\n",
    "    \"\"\"\n",
    "    Represents a hotel guest and inherits from Person.\n",
    "    \"\"\"\n",
    "\n",
    "    guest_count = 0\n",
    "\n",
    "    def __init__(self, name, id_number, phone, guest_type=\"Regular\"):\n",
    "        super().__init__(name, id_number)\n",
    "        self.phone = phone\n",
    "        self.guest_type = guest_type\n",
    "        self.registered_on = datetime.now().date()\n",
    "        Guest.guest_count += 1\n",
    "\n",
    "    def get_role(self):\n",
    "        return \"Guest\"\n",
    "\n",
    "    @classmethod\n",
    "    def number_of_guests(cls):\n",
    "        return cls.guest_count\n",
    "\n",
    "    @staticmethod\n",
    "    def validate_phone(phone):\n",
    "        if not isinstance(phone, str) or len(phone.strip()) < 7:\n",
    "            raise ValueError(\"Phone number must be a valid string.\")\n",
    "        return phone.strip()\n",
    "\n",
    "    def __str__(self):\n",
    "        return f\"Guest: {self.name} | Phone: {self.phone} | Type: {self.guest_type}\""
   ]
